class Node:
    def __init__(self, coeff, power):
        self.coeff = coeff
        self.power = power
        self.next = None


class Polynomial:
    def __init__(self):
        self.head = None

    def insert(self, coeff, power):
        """Inserts a term maintaining descending order of powers."""
        if coeff == 0:
            return
        
        new_node = Node(coeff, power)

        if self.head is None or self.head.power < power:
            new_node.next = self.head
            self.head = new_node
            return

        temp = self.head
        while temp.next and temp.next.power > power:
            temp = temp.next

        if temp.next and temp.next.power == power:
            temp.next.coeff += coeff
        elif temp.power == power:
            temp.coeff += coeff
        else:
            new_node.next = temp.next
            temp.next = new_node

    def get_constant_term(self):
        """Traverses to find and return the coefficient of power 0."""
        temp = self.head
        while temp:
            if temp.power == 0:
                return temp.coeff
            temp = temp.next
        return 0  # If no term with power 0 exists, the constant is 0

    def display(self):
        if self.head is None:
            print("0")
            return

        temp = self.head
        while temp:
            if temp != self.head and temp.coeff > 0:
                print(" + ", end="")
            elif temp != self.head and temp.coeff < 0:
                print(" - ", end="")
                
            c = abs(temp.coeff) if temp != self.head else temp.coeff
            
            # Print x^power only if power > 0. For power 0, just print the coefficient.
            if temp.power == 0:
                print(f"{c}", end="")
            elif temp.power == 1:
                print(f"{c}x", end="")
            else:
                print(f"{c}x^{temp.power}", end="")
                
            temp = temp.next
        print()


def add(poly1, poly2):
    p = poly1.head
    q = poly2.head
    result = Polynomial()
    
    dummy = Node(0, 0)
    tail = dummy

    def append_term(coeff, power):
        nonlocal tail
        if coeff != 0:
            if tail != dummy and tail.power == power:
                tail.coeff += coeff
            else:
                tail.next = Node(coeff, power)
                tail = tail.next

    while p and q:
        if p.power == q.power:
            append_term(p.coeff + q.coeff, p.power)
            p = p.next
            q = q.next
        elif p.power > q.power:
            append_term(p.coeff, p.power)
            p = p.next
        else:
            append_term(q.coeff, q.power)
            q = q.next

    while p:
        append_term(p.coeff, p.power)
        p = p.next

    while q:
        append_term(q.coeff, q.power)
        q = q.next

    result.head = dummy.next
    return result


# --- Execution Block ---
poly1 = Polynomial()
poly2 = Polynomial()

n1 = int(input("Enter number of terms in first polynomial: "))
print("Enter coefficient and power (in descending order of powers):")
for i in range(n1):
    c = int(input("Coefficient: "))
    p = int(input("Power: "))
    poly1.insert(c, p)

n2 = int(input("\nEnter number of terms in second polynomial: "))
print("Enter coefficient and power (in descending order of powers):")
for i in range(n2):
    c = int(input("Coefficient: "))
    p = int(input("Power: "))
    poly2.insert(c, p)

print("\nFirst Polynomial:")
poly1.display()

print("Second Polynomial:")
poly2.display()

sum_poly = add(poly1, poly2)

print("\nSum Polynomial:")
sum_poly.display()

# Extract and display the constant term
constant = sum_poly.get_constant_term()
print(f"Constant term of the sum: {constant}")
