class Stack:
    def __init__(this):
        this.stack = []

    def is_empty(this):
        return len(this.stack) == 0

    def push(this,value):
        this.stack.append(value)
        print(f"{value} has been added successfully inside the stack")

    def pop(this):
        if this.is_empty():
            return "Stack Under Flow"
        return this.stack.pop()

    def peek(this):
        if this.is_empty():
            return "Stack is Empty"
        return this.stack[-1]

    
    def size (this):
        return len(this.stack)

    def display(this):
        print("Stack elements : ",this.stack)


s = Stack()
s.push(10)
s.push(20)
s.push(30)
s.push(40)
s.push(50)

print("Popped Value : ",s.pop())
print("Top Value : ",s.peek())
s.display()
