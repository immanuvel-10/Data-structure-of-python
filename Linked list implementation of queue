class Node:
    def __init__ (self,data):
        self.data=data
        self.next=None

class Queue:
    def __init__ (self):
        self.front=None
        self.rear=None

    def is_empty(self):
        return self.front is None

    def enqueue(self,data):
        new_node=Node(data)
        if self.rear is None:
            self.front=self.rear=new_node
            return
        self.rear.next=new_node
        self.rear=new_node

    def dequeue (self):
        if self.is_empty():
            return None
        data = self.front.data
        self.front=self.front.next
        if self.front is None:
            self.rear=None
        return data

    def peek (self):
        if self.is_empty():
            return None
        return self.front.data

    def size (self):
        count=0
        temp=self.front
        while temp:
            count +=1
            temp=temp.next
        return count

    def display (self):
        temp=self.front
        print("stack :",end=" ")
        while temp:
            print(temp.data,end=" ")
            temp=temp.next


q=Queue()
n=int(input("Enter number of data : "))
for i in range(0,n):
    data=input("Enter data :")
    q.enqueue (data)
    i +=1

print("Dequeue data :",q.dequeue())
print("peek data :",q.peek())
print("Queue size :",q.size())
q.display()
